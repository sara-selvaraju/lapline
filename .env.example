# Copy to .env for local runs. Set the real values as Railway variables in production.

# Point at the mock during development; leave unset to use https://api.openf1.org
OPENF1_BASE=http://localhost:4001

# OpenF1 sponsor login, needed for live data during sessions
OPENF1_USERNAME=
OPENF1_PASSWORD=

# mqtt (default) or rest
LIVE_TRANSPORT=mqtt
LIVE_DELAY_S=10
SESSION_KEY=auto

# Access control: leave APP_PASSWORD empty to run without a password locally
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string
