# Copy to .env for `npm start`, which reads it; anything set in the shell wins
# over it. `npm run dev` does not read it: dev always runs against the mock, so
# it behaves the same on every machine. In production, set real values as the
# host's environment variables instead; never commit a .env.

# Point at the mock during development; leave unset to use https://api.openf1.org
OPENF1_BASE=http://localhost:4001

# OpenF1 sponsor login, needed for live data during sessions
OPENF1_USERNAME=
OPENF1_PASSWORD=

# mqtt (default) or rest
LIVE_TRANSPORT=mqtt
LIVE_DELAY_S=10
SESSION_KEY=auto

# Access control. Empty runs with no password at all, which is fine locally;
# the server warns at start if it is empty while using real OpenF1 data.
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string

# Development and test overrides, all optional
# Request spacing in ms; defaults to 2100 free tier, 1100 with credentials
OPENF1_MIN_GAP_MS=
# Port the mock listens on, default 4001
MOCK_PORT=
# Override the MQTT broker, default wss://mqtt.openf1.org:8084/mqtt
OPENF1_MQTT_URL=
